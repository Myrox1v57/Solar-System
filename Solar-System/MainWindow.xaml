<Window x:Class="Solar_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:k="http://schemas.microsoft.com/kinect/2013"
        xmlns:ui="clr-namespace:Solar_System.UI"
        mc:Ignorable="d"
        Title="Слънчева система с Kinect" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Window.Resources>
        <!-- The big Back button: rounded, see-through, and it lights up under the pointer or the hand. -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#B0182238" BorderBrush="#6F8FBF"
                                BorderThickness="2" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E03A5F96" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="Tag" Value="hand">
                                <Setter TargetName="Box" Property="Background" Value="#E03A5F96" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The Toolkit's KinectRegion tracks the hand. Its own cursor is hidden: see UI/HandCursor.cs. -->
    <k:KinectRegion x:Name="KinectArea" IsCursorVisible="False">

        <!-- InputSurface catches the pointer. It needs a background, or empty space gets no clicks. -->
        <Grid x:Name="InputSurface" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- The 3D scene. SceneBuilder fills it when the window opens. It ignores the pointer
                 because BodyPicker finds the planets, and testing every 3D triangle for each
                 hand update would be slow. -->
            <Viewport3D x:Name="SceneViewport" Grid.ColumnSpan="2" IsHitTestVisible="False" />

            <!-- Hover highlight, drawn over the 3D scene. -->
            <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Ellipse x:Name="HoverRing" Stroke="#BFE4FF" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#59B8FF" BlurRadius="20" ShadowDepth="0" Opacity="1" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="HoverLabel" FontSize="34" FontWeight="SemiBold" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Canvas>

            <!-- Shown while nobody controls the app with a hand. -->
            <Grid Grid.ColumnSpan="2" IsHitTestVisible="False">
                <!-- Hidden in Focus mode (the Back button is only there then), or the panel would cut it off. -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=BackButton}" Value="Visible">
                                <Setter Property="Opacity" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- A plain dark background, not a glow effect: effects over the moving 3D scene are slow. -->
                <Border x:Name="RaiseHandPrompt" Background="#B0070B16" CornerRadius="18" Padding="28,10"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64"
                        Visibility="Collapsed" Opacity="0">
                    <TextBlock Text="Застанете пред камерата и вдигнете ръка"
                               FontSize="42" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </Grid>

            <!-- The texture license (CC BY) requires this credit. -->
            <TextBlock Grid.ColumnSpan="2" Text="Текстури на планетите: Solar System Scope (CC BY 4.0)"
                       FontSize="18" Foreground="#9FB4D0" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" />

            <!-- Clicks pass through the panel, so it never blocks dragging the planet. -->
            <ui:InfoPanel x:Name="PlanetInfoPanel" Grid.Column="1" IsHitTestVisible="False" />

            <!-- Focusable="False", or Space would press this button instead of pausing. -->
            <Button x:Name="BackButton" Grid.ColumnSpan="2" Content="← Назад"
                    Style="{StaticResource BackButtonStyle}" Focusable="False"
                    Width="240" Height="120" Margin="28"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="Collapsed" Opacity="0" Click="OnBackClicked" />

            <ui:StatusIndicator x:Name="KinectStatus" Grid.ColumnSpan="2"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,14" />

            <!-- The hand cursor and its dwell ring come last, so they are on top of everything. -->
            <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Ellipse x:Name="DwellProgressRing" Width="96" Height="96" Stroke="#FFC56B" StrokeThickness="8"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="HandSymbol" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Canvas>
        </Grid>
    </k:KinectRegion>
</Window>
