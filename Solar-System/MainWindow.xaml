<Window x:Class="Solar_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Solar_System"
        mc:Ignorable="d"
        Title="Kinect Solar System" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid>
        <!-- The 3D scene. SceneBuilder fills it when the window opens. -->
        <Viewport3D x:Name="SceneViewport" />

        <!-- Small Kinect status in the corner. The full status indicator comes in Phase 4. -->
        <TextBlock x:Name="KinectStatusText"
                   Text="Looking for Kinect..."
                   FontSize="20" Foreground="Orange"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,24,16" />
    </Grid>
</Window>
