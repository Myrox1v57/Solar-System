<Window x:Class="Solar_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Solar_System.UI"
        mc:Ignorable="d"
        Title="Слънчева система с Kinect" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Window.Resources>
        <!-- The big Back button: rounded, see-through, and it lights up under the pointer. -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="#B0182238" BorderBrush="#6F8FBF"
                                BorderThickness="2" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E03A5F96" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- InputSurface catches the pointer. It needs a background, or empty space gets no clicks. -->
    <Grid x:Name="InputSurface" Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- The 3D scene. SceneBuilder fills it when the window opens. -->
        <Viewport3D x:Name="SceneViewport" Grid.ColumnSpan="2" />

        <!-- Hover highlight: a glowing circle and the planet's name, drawn over the 3D scene. -->
        <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Ellipse x:Name="HoverRing" Stroke="#BFE4FF" StrokeThickness="3">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#59B8FF" BlurRadius="20" ShadowDepth="0" Opacity="1" />
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="HoverLabel" FontSize="34" FontWeight="SemiBold" Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                </TextBlock.Effect>
            </TextBlock>
        </Canvas>

        <!-- Clicks pass through the panel, so it never blocks dragging the planet. -->
        <ui:InfoPanel x:Name="PlanetInfoPanel" Grid.Column="1" IsHitTestVisible="False" />

        <!-- Focusable="False", or Space would press this button instead of pausing. -->
        <Button x:Name="BackButton" Grid.ColumnSpan="2" Content="← Назад"
                Style="{StaticResource BackButtonStyle}" Focusable="False"
                Width="240" Height="120" Margin="28"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" Click="OnBackClicked" />

        <!-- Small Kinect status in the corner. The full status indicator comes in Phase 4. -->
        <TextBlock x:Name="KinectStatusText" Grid.ColumnSpan="2"
                   Text="Търсене на Kinect..."
                   FontSize="20" Foreground="Orange" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="24,0,0,16" />
    </Grid>
</Window>
