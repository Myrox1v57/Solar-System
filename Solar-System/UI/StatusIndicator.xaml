<UserControl x:Class="Solar_System.UI.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- A colored dot and a short text. -->
    <Border Background="#99070B16" CornerRadius="14" Padding="14,6">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="16" Height="16" Fill="Orange" VerticalAlignment="Center" />
            <TextBlock x:Name="MessageText" Margin="10,0,0,0" FontSize="20" Foreground="White"
                       Text="Търсене на Kinect..." VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
