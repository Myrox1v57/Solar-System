<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{B6F87005-D209-40E5-9F6B-FCD034034B5B}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Solar_System</RootNamespace>
    <AssemblyName>Solar-System</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WarningLevel>4</WarningLevel>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <!-- Only x64 builds: the Kinect interaction library (KinectInteraction180_64.dll) is 64-bit. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!--
    Where the Kinect SDK 1.8 and Developer Toolkit 1.8 are installed.
    Their installers set the environment variables KINECTSDK10_DIR and KINECT_TOOLKIT_DIR.
    If those are missing we fall back to the default install folders.
  -->
  <PropertyGroup>
    <KinectSdkDir Condition=" '$(KINECTSDK10_DIR)' != '' ">$([MSBuild]::EnsureTrailingSlash('$(KINECTSDK10_DIR)'))</KinectSdkDir>
    <KinectSdkDir Condition=" '$(KinectSdkDir)' == '' ">C:\Program Files\Microsoft SDKs\Kinect\v1.8\</KinectSdkDir>
    <KinectToolkitDir Condition=" '$(KINECT_TOOLKIT_DIR)' != '' ">$([MSBuild]::EnsureTrailingSlash('$(KINECT_TOOLKIT_DIR)'))</KinectToolkitDir>
    <KinectToolkitDir Condition=" '$(KinectToolkitDir)' == '' ">C:\Program Files\Microsoft SDKs\Kinect\Developer Toolkit v1.8.0\</KinectToolkitDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kinect SDK 1.8 (sensor, depth and skeleton data). Copied next to the .exe. -->
    <Reference Include="Microsoft.Kinect, Version=1.8.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(KinectSdkDir)Assemblies\Microsoft.Kinect.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- Kinect Developer Toolkit 1.8: KinectRegion, hand pointer, grip and press detection (used from Phase 4). -->
    <Reference Include="Microsoft.Kinect.Toolkit">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(KinectToolkitDir)Assemblies\Microsoft.Kinect.Toolkit.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Kinect.Toolkit.Controls">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(KinectToolkitDir)Assemblies\Microsoft.Kinect.Toolkit.Controls.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Kinect.Toolkit.Interaction">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(KinectToolkitDir)Assemblies\Microsoft.Kinect.Toolkit.Interaction.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xaml">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- 3D helpers: spheres, lines, textures. 2.27.x is the newest line that supports .NET Framework 4.8. -->
    <PackageReference Include="HelixToolkit.Wpf">
      <Version>2.27.3</Version>
    </PackageReference>
    <!--
      Build-time only: gives the compiler the .NET Framework 4.8 reference files, so the project
      builds even on a PC without the 4.8 Developer Pack. Nothing from it ships with the app.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies">
      <Version>1.0.3</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Native (C++) part of the Kinect interaction library. It must sit next to the .exe.
    The toolkit has used both "amd64" and "x64" as the folder name, so we look in both.
  -->
  <ItemGroup>
    <None Include="$(KinectToolkitDir)Redist\amd64\KinectInteraction180_64.dll" Condition="Exists('$(KinectToolkitDir)Redist\amd64\KinectInteraction180_64.dll')">
      <Link>KinectInteraction180_64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </None>
    <None Include="$(KinectToolkitDir)Redist\x64\KinectInteraction180_64.dll" Condition="!Exists('$(KinectToolkitDir)Redist\amd64\KinectInteraction180_64.dll') And Exists('$(KinectToolkitDir)Redist\x64\KinectInteraction180_64.dll')">
      <Link>KinectInteraction180_64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </None>
  </ItemGroup>

  <!-- Friendly build warnings if the Kinect files are not where we expect them. -->
  <Target Name="CheckKinectFiles" BeforeTargets="BeforeBuild">
    <Warning Condition="!Exists('$(KinectSdkDir)Assemblies\Microsoft.Kinect.dll')" Text="Kinect SDK 1.8 not found in '$(KinectSdkDir)'. Install 'Kinect for Windows SDK v1.8'." />
    <Warning Condition="!Exists('$(KinectToolkitDir)Assemblies\Microsoft.Kinect.Toolkit.dll')" Text="Microsoft.Kinect.Toolkit.dll not found in '$(KinectToolkitDir)Assemblies\'. Install 'Kinect for Windows Developer Toolkit v1.8'." />
    <Warning Condition="!Exists('$(KinectToolkitDir)Assemblies\Microsoft.Kinect.Toolkit.Controls.dll')" Text="Microsoft.Kinect.Toolkit.Controls.dll not found in '$(KinectToolkitDir)Assemblies\'. Install 'Kinect for Windows Developer Toolkit v1.8'." />
    <Warning Condition="!Exists('$(KinectToolkitDir)Assemblies\Microsoft.Kinect.Toolkit.Interaction.dll')" Text="Microsoft.Kinect.Toolkit.Interaction.dll not found in '$(KinectToolkitDir)Assemblies\'. Install 'Kinect for Windows Developer Toolkit v1.8'." />
    <Warning Condition="!Exists('$(KinectToolkitDir)Redist\amd64\KinectInteraction180_64.dll') And !Exists('$(KinectToolkitDir)Redist\x64\KinectInteraction180_64.dll')" Text="KinectInteraction180_64.dll not found in '$(KinectToolkitDir)Redist\'. Install 'Kinect for Windows Developer Toolkit v1.8'." />
  </Target>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\InfoPanel.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Include="UI\InfoPanel.xaml.cs">
      <DependentUpon>InfoPanel.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="AppLog.cs" />
    <Compile Include="Camera\CameraController.cs" />
    <Compile Include="Config\SimulationConfig.cs" />
    <Compile Include="Input\IPointerInput.cs" />
    <Compile Include="Input\KinectInput.cs" />
    <Compile Include="Input\MouseInput.cs" />
    <Compile Include="Interaction\InteractionController.cs" />
    <Compile Include="Model\CelestialBody.cs" />
    <Compile Include="Model\PlanetDataLoader.cs" />
    <Compile Include="Model\PlanetInfo.cs" />
    <Compile Include="Scene\BodyPicker.cs" />
    <Compile Include="Scene\BodyVisual.cs" />
    <Compile Include="Scene\SceneBuilder.cs" />
    <Compile Include="Scene\TextureLoader.cs" />
    <Compile Include="Simulation\SimulationClock.cs" />
    <Compile Include="UI\HoverMarker.cs" />
  </ItemGroup>

  <!-- Planet text and pictures: copied next to the .exe. Pictures that are not there yet are simply skipped. -->
  <ItemGroup>
    <Content Include="Assets\planets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    While compiling XAML, WPF makes a temporary copy of this project (named ..._wpftmp) that does
    not receive NuGet's settings. So we point that copy at the .NET 4.8 reference files ourselves.
    Keep the version here the same as the Microsoft.NETFramework.ReferenceAssemblies package above.
  -->
  <PropertyGroup>
    <Net48ReferenceTargets>$(UserProfile)\.nuget\packages\microsoft.netframework.referenceassemblies.net48\1.0.3\build\Microsoft.NETFramework.ReferenceAssemblies.net48.targets</Net48ReferenceTargets>
  </PropertyGroup>
  <Import Project="$(Net48ReferenceTargets)" Condition="$(MSBuildProjectName.EndsWith('_wpftmp')) And Exists('$(Net48ReferenceTargets)')" />
</Project>
